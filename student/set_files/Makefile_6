# Linux / macOS, inside this set folder (e.g. 00_Mixed/M01):
#   make      judge the whole set (problem folders 1 ... 6)
#   make 5    judge problem 5 only
PYTHON ?= python3
# Judge/ is in the package root: ../Judge from a topic folder, ../../Judge from a Mixed set (00_Mixed/M01)
JUDGE_PY := $(or $(firstword $(wildcard ../Judge/judge.py ../../Judge/judge.py)),../Judge/judge.py)
JUDGE  := $(PYTHON) $(JUDGE_PY)

all:
	@$(JUDGE)

1 2 3 4 5 6:
	@$(JUDGE) $@

.PHONY: all 1 2 3 4 5 6
